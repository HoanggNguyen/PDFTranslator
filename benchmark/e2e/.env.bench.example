# Read docs/HF_GUIDE.md first. Copy to root .env; never upload this filled file.
# Environment exports override .env. Values are parsed, never executed by shell.

# Local controller credential: Jobs submission + dataset/Space management.
HF_TOKEN=
# Runtime credential: read/write ONLY eval dataset + access to required gated models.
# Driver maps this to HF_TOKEN inside Jobs; never forwards the controller token.
HF_JOB_TOKEN=
HF_EVAL_REPO=your-user/pdftranslator-eval
HF_BENCH_SPACE=your-user/pdftranslator-bench
# Optional; create with hf buckets create your-user/pdftranslator-cache.
HF_CACHE_BUCKET=
# Optional immutable registry reference, otherwise driver uses HF_BENCH_SPACE image.
HF_BENCH_IMAGE=

# Must be reachable FROM HF, HTTPS, no credentials/query in URL.
LITELLM_BASE_URL=https://your-proxy.example/v1
BENCH_MODEL=your-exact-proxy-model-id

# Distinct budget-limited virtual keys. Driver selects ONE key per translation job.
# Alias on proxy: <run-id>-pdftranslator, <run-id>-babeldoc, <run-id>-pdfmathtranslate.
# Metadata aliases do not configure the proxy; set those aliases on the proxy too.
LITELLM_KEY_PDFTRANSLATOR=
LITELLM_KEY_BABELDOC=
LITELLM_KEY_PDFMATHTRANSLATE=

# Only used locally for four-system eval. Not sent to HF.
DEEPL_AUTH_KEY=

# Default run selection and job limits.
BENCH_RUN_ID=smoke-001
FLAVOR=t4-medium
TIMEOUT=3h

# Before real translation: enforce temperature=0 and disable response cache at proxy.
# prepare-* snapshots model/URL/systems/languages/flavor; use a NEW run-id to change.
# Legacy run_all.sh/direct runners use LITELLM_API_KEY; new HF driver does not.
