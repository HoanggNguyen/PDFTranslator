# =============================================================================
# Biến môi trường cho benchmark E2E. Chép các dòng cần vào `.env` Ở GỐC REPO
# (harness tự load_dotenv(), khỏi export tay).
#
#   cat benchmark/e2e/.env.bench.example >> .env   # rồi điền giá trị
#
# Ba nhóm, khác nhau về NƠI dùng:
#   [máy]   chỉ dùng ở máy      — DeepL, đẩy/kéo dataset
#   [job]   truyền vào job HF   — qua --secrets (bí mật) hoặc --env (không bí mật)
#   [chốt]  chốt một lần cho CẢ LƯỢT — đổi giữa chừng là bảng mất tính so sánh
# =============================================================================

# ── LLM: cả 3 hệ mã nguồn mở đi CHUNG một proxy ──────────────────── [job] ────
# Đây là điểm duy nhất ép được cùng model + cùng temperature cho cả ba.
LITELLM_BASE_URL=https://litellm.internal.cake.vn/v1
LITELLM_API_KEY=

# ── DeepL — chạy Ở MÁY, không lên HF ────────────────────────────── [máy] ────
# API thuần: trả tiền GPU để ngồi chờ HTTP là vô nghĩa. Gói Developer miễn phí
# 1.000.000 ký tự/tháng; T1 EN→VI tốn 353.661.
DEEPL_AUTH_KEY=

# ── Hugging Face ─────────────────────────────────────────── [máy] + [job] ───
# HF_TOKEN cần quyền WRITE: vừa để push dataset, vừa để job push ngược artifact lên.
# Nó cũng là thứ mở khoá model gated của CometKiwi — thiếu là job chết ở phút thứ 40
# với lỗi 401 chứ không phải lúc khởi động.
HF_TOKEN=
HF_USER=
HF_EVAL_REPO=                 # <user>/pdftranslator-eval        (dataset, chứa artifact)
HF_BENCH_SPACE=               # <user>/pdftranslator-bench       (Space, dùng làm image job)
HF_CACHE_BUCKET=              # <user>/pdftranslator-eval-cache  (bucket, mount vào /data)

# ── Chốt cho cả lượt chạy ────────────────────────────────────────── [chốt] ──
# BENCH_MODEL là BẮT BUỘC khi chạy baseline: để trống thì BabelDOC và
# PDFMathTranslate đều rơi về gpt-4o-mini, khác model của PDFTranslator, và
# `manifest verify` sẽ báo lỗi đỏ "model không đồng nhất".
BENCH_MODEL=

# Mỗi hệ một virtual key ở LiteLLM -> quy token/USD riêng từng hệ qua /spend/logs.
# Đây là đường DUY NHẤT lấy được số token của PDFMathTranslate: bản v1 không đếm
# token ở bất cứ đâu.
KEY_ALIAS_PREFIX=thesis-

# =============================================================================
# HAI VIỆC KHÔNG NẰM TRONG FILE NÀY, PHẢI LÀM Ở PHÍA LITELLM PROXY
# =============================================================================
# 1. ÉP temperature=0 cho BENCH_MODEL.
#    pdf2zh/translation/gateway.py hardcode 0.7 (dòng 146) và 0.2 (dòng 246),
#    không có knob config, mà harness thì không được sửa pdf2zh/. Hai baseline
#    gửi temperature=0. Không ép ở proxy thì hệ của bạn chạy ở nhiệt độ khác hai
#    đối thủ — bảng không bảo vệ được trước hội đồng.
#
# 2. Tạo 4 virtual key: thesis-pdftranslator, thesis-babeldoc,
#    thesis-pdfmathtranslate, thesis-ablation.
